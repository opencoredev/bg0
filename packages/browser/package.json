{
  "name": "@bg0/browser",
  "version": "0.1.2",
  "description": "Local browser background removal with WebGPU and WASM",
  "license": "Apache-2.0",
  "homepage": "https://bg0.dev/docs/library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencoredev/bg0.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/opencoredev/bg0/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/copy-heic-decoder.ts",
    "prepack": "bun run build",
    "lint": "biome lint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/bun": "^1.4.2",
    "heic-to": "1.5.2",
    "typescript": "^6.0.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
