{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_GOOGLE_SITE_VERIFICATION"],
      "outputs": ["dist/**", ".output/**"]
    },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^build", "^typecheck"] }
  }
}
