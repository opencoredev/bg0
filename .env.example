# Local browser removal needs no environment variables. Use this only to test
# PostHog away from bg0.dev; production analytics is restricted to bg0.dev and
# www.bg0.dev automatically.
# VITE_POSTHOG_ENABLED=true

# The web app proxies /docs to this origin during development.
# BG0_DOCS_ORIGIN=http://localhost:4321

# The docs logo links here during development. Production defaults to bg0.dev.
# BG0_PRODUCT_URL=http://localhost:3000

# Production builds upload private source maps to PostHog when both values are
# set. POSTHOG_API_KEY is a secret personal API key with error-tracking write
# access. POSTHOG_PROJECT_ID is the numeric project ID.
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.i.posthog.com
